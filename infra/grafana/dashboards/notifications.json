    {
      "id": 16,
      "type": "timeseries",
      "title": "Reintentos y replays / s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 25,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (channel) (rate(notifications_processed_total{result=\"retry\"}[1m]))",
          "legendFormat": "retry {{channel}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (channel) (rate(dead_letters_replayed_total[1m]))",

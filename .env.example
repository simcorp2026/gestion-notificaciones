# --- App
APP_ENV=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true

# --- Postgres (host local; dentro de compose se sobreescribe con el hostname del servicio)
POSTGRES_USER=notifications
POSTGRES_PASSWORD=notifications
POSTGRES_DB=notifications
POSTGRES_PORT=5433
DB_URL=postgresql+asyncpg://notifications:notifications@localhost:5433/notifications

# --- RabbitMQ
RABBITMQ_DEFAULT_USER=notifications
RABBITMQ_DEFAULT_PASS=notifications
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://notifications:notifications@localhost:5672/
RABBITMQ_MANAGEMENT_URL=http://localhost:15672/
RABBITMQ_PREFETCH=10
RABBITMQ_EXCHANGE=notifications
RABBITMQ_DELIVERY_LIMIT=10
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=10
RABBITMQ_RECONNECT_INTERVAL_SECONDS=2

# --- Relay
RELAY_BATCH_SIZE=100
RELAY_POLL_INTERVAL_SECONDS=1
RELAY_LISTEN_NOTIFY=true
RELAY_BACKOFF_BASE_SECONDS=1
RELAY_BACKOFF_MAX_SECONDS=60

# --- Retry (lista JSON, segundos por nivel)
RETRY_DELAYS_SECONDS=[5,30,300]

# --- API
API_ADMIN_KEY=change-me-please-0123456789
API_PORT=8000

# --- Worker (proveedor simulado). En compose cada canal tiene su propia tasa (EMAIL_/SMS_/PUSH_*)
WORKER_SIM_LATENCY_MIN_MS=50
WORKER_SIM_LATENCY_MAX_MS=300
WORKER_SIM_TRANSIENT_FAILURE_RATE=0.1
WORKER_SIM_PERMANENT_FAILURE_RATE=0.0
WORKER_DRAIN_TIMEOUT_SECONDS=30

# --- Observabilidad
METRICS_ENABLED=true
METRICS_PORT=9100
METRICS_MONITOR_INTERVAL_SECONDS=5
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
